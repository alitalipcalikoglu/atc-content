# --- Server ---
PORT=3013
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Imports send a whole locale in one request; 1 MiB default.
BODY_LIMIT=1048576

# --- Storage ---
DB_PATH=./data/content.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=

# --- Callers: id:secret[:role], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: write (edit, import, publish), read (bundles, export, list, stats, metrics), readwrite (default).
# id:secret[:role[:namespaces]] - a key with namespaces (web+shop) reaches only those; without, all.
CONTENT_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS,web-frontend:REPLACE_WITH_64_HEX_CHARS:read:web
# Key ids that may name the acting person in an X-Actor header (the console sends the signed-in admin's username).
# Records then show that name instead of the key id. Ignored for every other key.
ACTOR_KEYS=
# true: GET /v1/bundles/* also answers requests without an Authorization header (published strings only).
CONTENT_PUBLIC_BUNDLES=false
# Requests per key (per IP for anonymous bundle requests) per minute.
RATE_LIMIT_MAX=1200

# --- Limits ---
# Characters per translated value.
MAX_VALUE_LENGTH=4096
MAX_KEYS_PER_NAMESPACE=20000
MAX_LOCALES_PER_NAMESPACE=50
# Releases kept per namespace; older ones are deleted on publish.
RELEASE_RETENTION=100
# true: publishing needs every draft value approved (POST /v1/namespaces/:ns/review) by someone other than its writer.
PUBLISH_REQUIRES_REVIEW=false

# --- Events (optional): publish events to atc-webhook-out. Both or neither. A publish-role key on webhook-out.
WEBHOOK_OUT_URL=
WEBHOOK_OUT_API_KEY=
WEBHOOK_OUT_TIMEOUT_MS=5000

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-content:…:write
AUDIT_URL=
AUDIT_API_KEY=
